// 이 파일을 Config/Secrets.xcconfig로 복사해 실제 값을 채운다. Secrets.xcconfig는 git에 올리지 않는다.
// xcconfig에서 //는 주석이라 URL의 //는 $() 로 끊어 쓴다. 예: https:/$()/abcd.supabase.co
// anon(공개) 키만 넣는다. service_role 키는 절대 넣지 않는다.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Xcode > Settings > Accounts에서 확인한 Personal Team ID. 비워 두면 Xcode에서 Team을 직접 고른다.
DEVELOPMENT_TEAM =
